# Copie este arquivo para ".env" (sem o .example) e preencha.
# O arquivo .env NUNCA vai para o GitHub (já está no .gitignore).

# Senha de acesso ao painel (/admin). Obrigatória. Escolha uma senha longa.
ADMIN_PASSWORD=troque-esta-senha

# Opcional — chave que assina o login. Se ficar em branco, o sistema cria uma
# sozinho na pasta "instance/". Em produção, defina uma fixa:
# SECRET_KEY=

# Opcional — ligue (1) só quando o site estiver em HTTPS.
# COOKIE_SEGURO=1

# Opcional — modo de desenvolvimento (recarrega sozinho ao editar o código).
# FLASK_DEBUG=1

# Opcional — outro caminho para o banco de dados.
# DATABASE_PATH=database.db
